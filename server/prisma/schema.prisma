generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model Users {
  Id              Int      @id(map: "PK_Users") @default(autoincrement())
  FullName        String   @db.NVarChar(Max)
  UserName        String   @db.NVarChar(Max)
  Password        String   @db.NVarChar(Max)
  Role            String   @db.NVarChar(Max)
  IsSecondaryUser Boolean
  UserId          String   @db.NVarChar(Max)
  Phone           String?  @db.NVarChar(Max)
  Email           String?  @db.NVarChar(Max)
  Address         String?  @db.NVarChar(Max)
  CreatedDate     DateTime
  EditedDate      DateTime
  Roles           Roles[]

  @@map("Users")
}

model Roles {
  Id      Int     @id(map: "PK_Roles") @default(autoincrement())
  Key     String  @db.NVarChar(Max)
  Value   Boolean
  UsersId Int
  User    Users   @relation(fields: [UsersId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Roles_Users_UsersId")

  @@index([UsersId], map: "IX_Roles_UsersId")
  @@map("Roles")
}

model SystemRecords {
  Id           Int        @id(map: "PK_SystemRecords") @default(autoincrement())
  UserFullName String     @db.NVarChar(Max)
  DeviceName   String     @db.NVarChar(Max)
  MachinId     String     @db.NVarChar(Max)
  Title        String     @db.NVarChar(Max)
  Description  String     @db.NVarChar(Max)
  CreatedDate  DateTime
  UsersId      Int
  EmployeesId  Int?
  Employee     Employees? @relation(fields: [EmployeesId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_SystemRecords_Employees_EmployeesId")

  @@index([UsersId])
  @@index([CreatedDate])
  @@index([EmployeesId], map: "IX_SystemRecords_EmployeesId")
  @@map("SystemRecords")
}

model Employees {
  Id                Int                @id(map: "PK_Employees") @default(autoincrement())
  Name              String             @db.NVarChar(Max)
  LastName          String             @db.NVarChar(Max)
  DateOfBirth       DateTime
  PlaceOfBirth      String             @db.NVarChar(Max)
  Gender            String             @db.NVarChar(Max)
  MaritalStatus     String             @db.NVarChar(Max)
  ProfileImagePath  String             @db.NVarChar(Max)
  Province          String             @db.NVarChar(Max)
  Directorate       String             @db.NVarChar(Max)
  Department        String             @db.NVarChar(Max)
  AddedDate         DateTime
  UpdateDate        DateTime
  UsersId           String             @db.NVarChar(Max)
  NIN               String             @db.NVarChar(Max)
  SIS               String             @db.NVarChar(Max)
  AssignedPosition  String             @db.NVarChar(Max)
  CorpsType         String?            @db.NVarChar(Max) @default("سلك_مشترك")
  ConfirmationDate  DateTime?
  Degree            Int
  EmployeeStatus    String?            @default("نشط") @db.NVarChar(50)
  InstallationDate  DateTime
  JobTitleId        Int
  LastDegreeDate    DateTime
  PositionDate      DateTime?
  StatusDate        DateTime
  Address           String             @db.NVarChar(Max)
  Email             String             @db.NVarChar(Max)
  NumberOfChildren  Int
  PhoneNumber       String             @db.NVarChar(Max)
  IsProfileComplete Boolean
  EmployeeFiles     EmployeeFiles[]
  JobTitle          JobTitles          @relation(fields: [JobTitleId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Employees_JobTitles_JobTitleId")
  EmployeesRecords  EmployeesRecords[]
  EmployeeStates    EmployeeStates[]
  LeaveBalances     LeaveBalance[]
  SpecialCases      SpecialCases[]
  PositionHistories PositionHistory[]
  RankHistories     RankHistory[]
  DegreeHistories   DegreeHistory[]
  SystemRecords     SystemRecords[]

  @@index([JobTitleId], map: "IX_Employees_JobTitleId")
  @@index([EmployeeStatus], map: "IX_Employees_EmployeeStatus")
  @@map("Employees")
}

model LeaveBalance {
  Id            Int       @id(map: "PK_LeaveBalance") @default(autoincrement())
  EmployeeId    Int
  Year          Int
  TotalDays     Int       @default(30)
  ConsumedDays  Int       @default(0)
  RemainingDays Int       @default(30)
  Employee      Employees @relation(fields: [EmployeeId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_LeaveBalance_Employees_EmployeeId")

  @@unique([EmployeeId, Year], map: "UQ_LeaveBalance_EmployeeId_Year")
  @@index([EmployeeId], map: "IX_LeaveBalance_EmployeeId")
  @@map("LeaveBalance")
}

model DegreeHistory {
  Id                Int       @id @default(autoincrement())
  EmployeesId       Int
  DegreeLevel       Int
  PromotionDuration String    @db.NVarChar(50)
  EffectiveDate     DateTime
  ReferenceDoc      String    @db.NVarChar(Max)
  Notes             String?   @db.NVarChar(Max)
  Employee          Employees @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, map: "FK_DegreeHistory_Employees_EmployeesId")

  @@index([EmployeesId])
  @@index([EffectiveDate])
  @@map("DegreeHistory")
}

model EmployeeFiles {
  Id           Int       @id(map: "PK_EmployeeFiles") @default(autoincrement())
  Category     String    @db.NVarChar(Max)
  FileName     String    @db.NVarChar(Max)
  FilePath     String    @db.NVarChar(Max)
  UploadDate   DateTime
  EmployeesId  Int
  DocumentDate DateTime
  DocumentName String    @db.NVarChar(Max)
  Employee     Employees @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_EmployeeFiles_Employees_EmployeesId")

  @@index([EmployeesId], map: "IX_EmployeeFiles_EmployeesId")
  @@map("EmployeeFiles")
}

model EmployeesRecords {
  Id                Int       @id(map: "PK_EmployeesRecords") @default(autoincrement())
  Name              String    @db.NVarChar(Max)
  JobTitle          String    @db.NVarChar(Max)
  EmpState          String    @db.NVarChar(Max)
  LastPromotionDate DateTime
  CurrentDegree     Int
  CurrentStage      Int
  CurrentSalary     Float     @db.Real
  CurrentDate       DateTime
  NextDegree        Int
  NextStage         Int
  NextSalary        Float     @db.Real
  NextDate          DateTime
  Note              String    @db.NVarChar(Max)
  AddedDate         DateTime
  UpdateDate        DateTime
  UsersId           String    @db.NVarChar(Max)
  EmployeesId       Int
  Employee          Employees @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_EmployeesRecords_Employees_EmployeesId")

  @@index([EmployeesId], map: "IX_EmployeesRecords_EmployeesId")
  @@map("EmployeesRecords")
}

model EmployeeStates {
  Id                    Int       @id(map: "PK_EmployeeStates") @default(autoincrement())
  EmployeesId           Int
  RecordCategory        String    @db.NVarChar(Max)
  CurrentJobTitle       String    @db.NVarChar(Max)
  StateTypeOrReason     String    @db.NVarChar(Max)
  DaysCount             Int
  StartDate             DateTime
  EndDate               DateTime
  AddedDate             DateTime
  UsersId               String    @db.NVarChar(Max)
  ActualReturnDate      DateTime?
  IsResumed             Boolean
  RequestedDays         Int?
  ResumptionDate        DateTime?
  IsResumedEarly        Boolean   @default(false)
  RemainingBalanceAfter Int?
  Employee              Employees @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_EmployeeStates_Employees_EmployeesId")

  @@index([EndDate])
  @@index([IsResumed])
  @@index([EmployeesId], map: "IX_EmployeeStates_EmployeesId")
  @@map("EmployeeStates")
}

model SpecialCases {
  Id           Int       @id(map: "PK_SpecialCases") @default(autoincrement())
  EmployeesId  Int
  CaseType     String    @db.NVarChar(Max)
  StartDate    DateTime
  EndDate      DateTime?
  Destination  String?   @db.NVarChar(Max)
  ReferenceDoc String    @db.NVarChar(Max)
  IsActive     Boolean   @default(true)
  CreatedAt    DateTime  @default(now())
  Employee     Employees @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_SpecialCases_Employees_EmployeesId")

  @@index([EmployeesId], map: "IX_SpecialCases_EmployeesId")
  @@index([IsActive], map: "IX_SpecialCases_IsActive")
  @@map("SpecialCases")
}

model RankHistory {
  Id          Int        @id @default(autoincrement())
  EmployeesId Int
  RankId      Int?
  RankName    String     @db.NVarChar(Max)
  InstallDate DateTime
  Reference   String     @db.NVarChar(Max)
  Notes       String     @db.NVarChar(Max)
  Employee    Employees  @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, map: "FK_RankHistory_Employees_EmployeesId")
  Rank        JobTitles? @relation(fields: [RankId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_RankHistory_JobTitles_RankId")

  @@index([EmployeesId])
  @@index([RankId])
  @@index([InstallDate])
  @@map("RankHistory")
}

model PositionHistory {
  Id           Int       @id @default(autoincrement())
  EmployeesId  Int
  PositionName String    @db.NVarChar(Max)
  InstallDate  DateTime
  EndDate      DateTime?
  Reference    String    @db.NVarChar(Max)
  Employee     Employees @relation(fields: [EmployeesId], references: [Id], onDelete: Cascade, map: "FK_PositionHistory_Employees_EmployeesId")

  @@index([EmployeesId])
  @@index([InstallDate])
  @@map("PositionHistory")
}

model JobTitles {
  Id                 Int           @id(map: "PK_JobTitles") @default(autoincrement())
  EmploymentCategory String        @db.NVarChar(Max)
  RankName           String        @db.NVarChar(Max)
  CategoryLevel      String        @db.NVarChar(Max)
  IndexNumber        Int
  AddedDate          DateTime
  UsersId            String        @db.NVarChar(Max)
  Employees          Employees[]
  RankHistories      RankHistory[]

  @@map("JobTitles")
}

model SystemSettings {
  Id        Int      @id @default(autoincrement())
  Key       String   @unique @db.NVarChar(255)
  Value     String   @db.NVarChar(Max)
  UpdatedAt DateTime

  @@map("SystemSettings")
}

/// هذا الجدول خاص بـ Entity Framework Core ولا يجب على Prisma حذفه
model EFMigrationsHistory {
  MigrationId    String @id(map: "PK___EFMigrationsHistory") @db.NVarChar(150)
  ProductVersion String @db.NVarChar(32)

  @@map("__EFMigrationsHistory")
  @@ignore
}

/// هذا الجدول خاص بمخططات SQL Server
model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B61164B7104") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
  @@ignore
}
