{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "prisma.config.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "node_modules/**/*"
  ]
}
