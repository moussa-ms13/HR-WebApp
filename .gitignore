# ============================================================
# HR-WebApp — Root .gitignore
# ============================================================

# IDE / Tooling customizations
.agents/
MEMORY.md

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables (NEVER commit secrets)
.env
.env.*
.env.local
.env.development
.env.production

# Uploaded files (user data — do not version-control)
uploads/employee_images/*
uploads/employee_documents/*
!uploads/employee_images/.gitkeep
!uploads/employee_documents/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma
prisma/migrations/

# Misc
*.local
*.tsbuildinfo
